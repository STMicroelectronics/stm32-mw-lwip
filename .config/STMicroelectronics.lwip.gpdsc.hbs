{{assign "lwipFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "LwIP"}')~}}
{{assign 'lwip_context' (@root.SWConfigurationAPI.getInstancesConfiguration @root.lwipFilter)~}}
{{assign 'lwip_cxt' @root.lwip_context.[0].settings.parameters~}}
{{log "LwIP Config template lwip_cxt:" (toJSON @root.lwip_cxt)~}}

{{assign 'use_freertos' false~}}
{{assign 'use_lwiperf' false~}}
{{assign 'use_sntp' false~}}
{{assign 'use_mdns' false~}}
{{assign 'use_common_port' true~}}
{{assign 'use_ethernet_interface' false~}}
{{assign 'use_custom_interface' false~}}
{{#if (eq @root.lwip_cxt.core.basic.freertos true)~}}
  {{~assign 'use_freertos' true~}}
{{/if}}
{{#if (eq @root.lwip_cxt.core.applicative.lwiperf_enabled true)~}}
  {{~assign 'use_lwiperf' true~}}
{{/if}}
{{#if (eq @root.lwip_cxt.core.applicative.sntp_client true)~}}
  {{~assign 'use_sntp' true~}}
{{/if}}
{{#if (eq @root.lwip_cxt.core.applicative.mdns_enabled true)~}}
  {{~assign 'use_mdns' true~}}
{{/if}}
{{#if (@root.EnvVarAPI.getVariableValue 'lwip_ethernet_interface')}}
  {{~assign 'use_ethernet_interface' true~}}
{{/if}}
{{#if (@root.EnvVarAPI.getVariableValue 'lwip_custom_interface')}}
  {{~assign 'use_custom_interface' true~}}
{{/if}}
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32*">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updates--}}
  <releases>
    <release version="2.0.0" date="2026-03-13">
      - First GPDSC LwIP
    </release>
  </releases>
  <conditions>
  {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="lwip condition")~}}
    {{{@root.conditions}}}
    <condition id="lwip condition">
      <description>lwip condition</description>
      <require Cclass="Network" Cgroup="LwIP" Csub="Core"/>
      {{#if (eq use_freertos true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="RTOS port" Cvariant="FreeRTOS"/>
      {{/if}}
      {{#if (eq use_common_port true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="Common port" Cvariant="STM32"/>
      {{/if}}
      {{#if (eq use_ethernet_interface true)}}
        {{#if (eq use_freertos true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="STM32 ETH Interface FreeRTOS"/>
        {{/if}}
      {{/if}}
      {{#if (eq use_custom_interface true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="STM32 Custom Interface"/>
      {{/if}}
      {{#if (eq use_lwiperf true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="LWIPERF"/>
      {{/if}}
      {{#if (eq use_sntp true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="SNTP"/>
      {{/if}}
      {{#if (eq use_mdns true)}}
      <require Cclass="Network" Cgroup="LwIP" Csub="MDNS"/>
      {{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      <files>
        {{#each files_array}}
        {{#if (eq gen_file 'lwipopts_user.h')}}
        {{#if @root.lwip_cxt.core.applicative.generate_lwipopts_user_h}}
        <file category="{{category}}" name="{{gen_file}}" attr="config" />
        {{/if}}
        {{else}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/if}}
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>